# Узел: либо папка, либо файл
class Node:
    def __init__(self, name, is_file=False, size=0):
        self.name = name
        self.is_file = is_file
        self.size = size
        self.children = []
        self.parent = None

    def add(self, node):
        node.parent = self
        self.children.append(node)


# Файловая система
class FileSystem:
    def __init__(self):
        self.root = Node("/")
        self.here = self.root  # где мы сейчас

    # найти внутри текущей папки
    def find(self, name):
        for c in self.here.children:
            if c.name == name:
                return c
        return None

    # создать папку
    def mkdir(self, name):
        if self.find(name):
            print("уже есть:", name)
            return
        self.here.add(Node(name))
        print("папка:", name)

    # создать файл
    def touch(self, name, size=10):
        if self.find(name):
            print("уже есть:", name)
            return
        self.here.add(Node(name, True, size))
        print("файл:", name, size, "б")

    # перейти в папку
    def cd(self, name):
        if name == "..":
            if self.here.parent:
                self.here = self.here.parent
            return
        node = self.find(name)
        if node and not node.is_file:
            self.here = node
        else:
            print("нет папки:", name)

    # показать содержимое
    def ls(self):
        print("в", self.here.name + ":")
        for c in self.here.children:
            print(" ", "файл" if c.is_file else "папка", c.name, c.size if c.is_file else "")

    # размер папки (рекурсия)
    def size(self, node=None):
        if node is None:
            node = self.root
        if node.is_file:
            return node.size
        total = 0
        for c in node.children:
            total += self.size(c)
        return total

    # самый глубокий путь
    def deepest(self, node=None, path=""):
        if node is None:
            node = self.root
            path = "/"

        # если детей нет — это конец
        if not node.children:
            return path, 1

        best_path = path
        best_depth = 1
        for c in node.children:
            new_path = path + c.name if path.endswith("/") else path + "/" + c.name
            p, d = self.deepest(c, new_path)
            if d + 1 > best_depth:
                best_depth = d + 1
                best_path = p
        return best_path, best_depth


# Проверка
fs = FileSystem()
fs.mkdir("home")
fs.cd("home")
fs.mkdir("docs")
fs.touch("readme.txt", 100)
fs.cd("docs")
fs.touch("report.pdf", 500)
fs.mkdir("archive")
fs.cd("archive")
fs.touch("old.zip", 1000)

print("\nразмер ФС:", fs.size(), "б")
p, d = fs.deepest()
print("самый глубокий:", p, "глубина", d)
