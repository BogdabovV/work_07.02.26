tree = [None, 1, 2, 3, 4, 5, None, 6]

def check(i):
    if i >= len(tree) or tree[i] is None:
        return 0
    left_h = check(2 * i)
    if left_h == -1:
        return -1
    right_h = check(2 * i + 1)
    if right_h == -1:
        return -1
    if abs(left_h - right_h) > 1:
        return -1
    return max(left_h, right_h) + 1

def is_balanced():
    return check(1) != -1

print(is_balanced())
